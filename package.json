{
  "name": "japanese-learning",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "mkdir -p public/dict && cp node_modules/kuromoji/dict/*.dat.gz public/dict/ && cp node_modules/kuromoji/build/kuromoji.js public/kuromoji.js",
    "vocab:generate": "node scripts/generate-vocab.mjs",
    "dev": "vp dev",
    "build": "pnpm run vocab:generate && vp build",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "vp lint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.2",
    "@playwright/test": "^1.50.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "kuromoji": "^0.1.2",
    "typescript": "^7.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.78.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
